    {
      "parameters": {
        "jsCode": "// 1. EL NODO LOOP: Traemos los datos originales\nconst datosCandidato = $('Loop Over Items').item.json;\n\n// 2. LA SALIDA DE LA IA: Usamos la ruta exacta que nos muestra tu nodo de Gemini\nlet textoIA = $input.item.json.content.parts[0].text;\n\n// 3. LIMPIEZA: Quitamos las comillas raras (ahora sí funcionará porque es texto puro)\ntextoIA = textoIA.replace(/```json/g, \"\").replace(/```/g, \"\").trim();\n\nlet datosIA = {};\ntry {\n    // Convertimos a JSON real\n    datosIA = JSON.parse(textoIA);\n} catch (error) {\n    // PROTECCIÓN ANTI-ERRORES\n    datosIA = {\n        \"Conclusion_IA\": \"Error: La IA no devolvió el formato JSON correctamente.\",\n        \"Puntaje_IA\": \"0\"\n    };\n}\n\n// 4. EL JOIN: Pegamos los datos del form con los datos de la IA\nreturn {\n    json: {\n        ...datosCandidato,\n        ...datosIA\n    }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
