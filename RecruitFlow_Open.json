      "parameters": {
        "jsCode": "// Filtro para que solo pase una vez\nif ($itemIndex > 0) return [];\n\nconst item = $('datos_form').first().json;\nconst titulosBase = Object.keys(item).filter(t => t !== 'row_number');\n\nconst columnasIA = [\n  \"Formacion_Academica\",\n  \"Resumen_Experiencia\",\n  \"Competencias_Especificas\",\n  \"Habilidades_Tecnicas\",\n  \"Puntaje_IA\",\n  \"Conclusion_IA\",\n  \"Sueldo_Sugerido\"\n];\n\nlet filaVacia = {};\n[...titulosBase, ...columnasIA].forEach(t => {\n  // ACÁ ESTÁ LA MAGIA: Le decimos que el valor sea un texto vacío\n  filaVacia[t] = \"\"; \n});\n\nreturn [{ json: filaVacia }];"
      },
